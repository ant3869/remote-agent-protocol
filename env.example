# Remote Agent Protocol environment overrides
#
# Copy this file to .env and uncomment only what you need. The application has
# working defaults for every non-secret setting; this is a reference, not a
# checklist. Provider examples for the vendored Pipecat framework belong in
# its own examples and are intentionally omitted here.

# Core models and diagnostics
#DEBUG_MODE=false
#LLM_MODEL=gemma-e4b-max
#OLLAMA_HOST=http://localhost:11434
#DEFAULT_PERSONA_NAME=Jess

# Cloud models (optional). A local 12B persona spends seconds composing every
# reply before you hear anything; a hosted model answers in a fraction of that.
# Any OpenAI-compatible endpoint works -- OpenRouter, Groq, DeepSeek, Together,
# OpenAI -- so no provider is assumed here. Set a base URL, a key, and at least
# CLOUD_LLM_MODEL to switch on; leave blank to stay entirely local.
#
# Whatever is configured is tried FIRST and falls back to the local model on any
# failure by default, so an expired key or a provider outage costs one slow turn
# rather than a broken app. Set this false to make the assistant cloud-only: it
# skips local chat/router warmups and never silently takes VRAM for an Ollama fallback.
#CLOUD_LLM_LOCAL_FALLBACK=false
# The short path: one OpenRouter key reaches every provider, and the base URL
# and a default model follow from it, so this line alone turns cloud on.
#OPENROUTER_API_KEY=
# Or point at any other OpenAI-compatible host; these win over the line above.
#CLOUD_LLM_BASE_URL=https://openrouter.ai/api/v1
#CLOUD_LLM_API_KEY=
# The persona that speaks -- the one that decides how long you wait.
#CLOUD_LLM_MODEL=
# Optional comma-separated ids displayed until the live provider catalog loads.
#CLOUD_LLM_MODEL_CHOICES=
# The router and the orchestrator's reasoning run per turn on short prompts, so
# a small fast model suits them. Both default to CLOUD_LLM_MODEL.
#CLOUD_INTENT_MODEL=
#CLOUD_ORCHESTRATION_MODEL=
#CLOUD_LLM_TIMEOUT_SECS=20
# Providers reserve a request's maximum possible cost before running it, so an
# uncapped reply is refused unless the balance could cover the model running to
# its full output length. Spoken replies are short; raise this only if the
# persona is being cut off mid-sentence.
#CLOUD_LLM_MAX_TOKENS=512

# --- Model presets (benchmarked with voice_probe; see voice_probe/README.md) ---
# Two knobs define a profile: LLM_MODEL is the voice/chat model (runs every
# turn) and INTENT_MODEL is the router classifier (runs only on ambiguous turns
# -- explicit commands, keyword hits, and smalltalk skip it).
#
# THE CONSTRAINT: both models are resident at once, and their LOADED footprint
# (weights + KV-cache, not the file size) must fit the GPU or Ollama swaps them
# every turn and the classifier times out. The classifier's context is capped
# (see classify_with_ollama) so it stays small; on 16GB a ~2.3GB classifier
# (qwen2.5:3b) co-resides with a 12B voice model (~10GB), but the 6GB
# gemma-e4b-aggressive does not -- it only fits beside a small (~6GB) voice.
#
# QUALITY -- 12B voice smarts + solid routing (~12.3GB loaded, the default).
#            gemma-12b-huihui replies ~0.7s; qwen2.5:3b routes at 81% on
#            voice_probe and stays resident beside it (~1s classify).
#   LLM_MODEL=gemma-12b-huihui
#   INTENT_MODEL=qwen2.5:3b
#   INTENT_TIMEOUT_SECS=2.5
#
# SNAPPY  -- fast voice + best routing (~12GB loaded). Voice reply ~0.2-0.7s;
#            gemma-e4b-aggressive routes at 92% (its 6GB fits beside the ~6GB
#            e4b voice, not beside a 12B voice).
#   LLM_MODEL=gemma-e4b-max
#   INTENT_MODEL=gemma-e4b-aggressive
#   INTENT_TIMEOUT_SECS=3.0
#
# Avoid: pairing a 12B voice model with gemma-e4b-aggressive (overflows 16GB ->
# classifier times out on every turn); gemma-12b as INTENT_MODEL (~2s/call);
# hermes-20b as a standing LLM_MODEL (~15GB). LLM_MODEL can also be set
# per-persona in data/persona_overrides.json; INTENT_MODEL is global only.

# Speech-to-text and audio devices. Blank device indices use system defaults.
#STT_ENGINE=whisper
#WHISPER_MODEL=large-v3-turbo
#WHISPER_DEVICE=cuda
#WHISPER_COMPUTE_TYPE=float16
#MIC_DEVICE_INDEX=
#SPEAKER_DEVICE_INDEX=
#VAD_CONFIDENCE=0.6
#VAD_START_SECS=0.1
#VAD_STOP_SECS=0.6
#VAD_MIN_VOLUME=0.6

# Text-to-speech: kokoro (local), coqui (local), cartesia (cloud), or voicebox (local server).
#TTS_BACKEND=kokoro
#CARTESIA_API_KEY=
#CARTESIA_TRANSPORT=http
#VOICEBOX_BASE_URL=http://127.0.0.1:18080
#VOICEBOX_SERVER_EXE=
#VOICEBOX_DATA_DIR=
#VOICEBOX_DEFAULT_ENGINE=qwen
#VOICEBOX_DEFAULT_MODEL=1.7B
#VOICEBOX_SAMPLE_RATE=24000
#VOICEBOX_WARMUP_ENABLED=true
#VOICEBOX_WARMUP_TEXT=hi
#VOICEBOX_WARMUP_DELAY_SECS=8
#COQUI_TTS_SOURCE_DIR=./TTS
#COQUI_TTS_MODEL=tts_models/en/ljspeech/vits
#COQUI_TTS_SPEAKER=
#COQUI_TTS_LANGUAGE=
#COQUI_TTS_DEVICE=cpu
#COQUI_TTS_SAMPLE_RATE=24000
#COQUI_TTS_MODEL_CACHE_SECS=300

# Wake word. Requires openwakeword; failures fall back to always-listening.
# Local models under remote_agent_protocol/wake_word/wake_models are discovered automatically.
#WAKE_WORD_ENABLED=false
#WAKE_WORD_ENGINE=openwakeword
#WAKE_WORD_MODEL=hey_jarvis
#WAKE_WORD_THRESHOLD=0.5
# How long the wake phrase buys you to start talking, and how long a reply that
# ends in a question stays answerable without saying it again (0 disables).
#WAKE_WORD_ACTIVE_WINDOW_SECS=8
#WAKE_WORD_FOLLOW_UP_SECS=15
# Optional JSON model-to-persona map; unavailable local secondary models are skipped.
#WAKE_WORD_PERSONAS_JSON={"hey_jarvis":"Jarvis","hey_jess":"Jess"}
#WAKE_WORD_SWITCH_TIMEOUT_SECS=0.5

# Shared prompt context hold timeout.
#CONTEXT_DRAFT_TIMEOUT_SECS=300

# Local semantic-memory namespace. Defaults to the current OS username.
#MEM0_USER_ID=local-user

# "mock" instantly "completes" any task with a canned response -- handy for
# smoke-testing dispatch/announce/consult without a real agent installed, but
# it must never be reachable from a live session (it would silently swallow
# real requests). Off by default; set to 1 only for a deliberate manual test.
#AGENT_MOCK_BACKEND_ENABLED=false

# Delegated agent backends. Commands are JSON argument arrays; {task} is
# replaced with the request. Use a trusted launcher for remote machines.
#AGENT_BACKENDS_JSON={"openclaw":["trusted-launcher","openclaw","{task}"]}
#OPENCLAW_AGENT_ID=jax
#AGENT_MACHINES_JSON={"openclaw":"Laptop"}
#AGENT_LOCAL_MACHINE=Main PC
#AGENT_DEFAULT_BACKEND=hermes

# Per-harness Kokoro voice ids (distinct from every persona voice) so a
# finished/failed job is recognizable by ear. Only override/add entries here;
# the built-in defaults cover hermes/openclaw/code-puppy/codex/claude-code.
#HARNESS_VOICES_JSON={"openclaw":"am_adam"}
# Spoken completion answers longer than this get a trimmed lead-in instead of
# a full verbatim readout; 0 always speaks the full answer.
#AGENT_RESULT_SPEAK_MAX_CHARS=220
# Speak "<agent> started on <task>" (only when it's the sole active job).
#AGENT_ANNOUNCE_START=true

# Spoken narration of agent work is written fresh every time, so no status
# sentence is ever heard twice. It runs on the model the intent router already
# keeps resident, so it costs no extra VRAM; past the deadline a rotating
# stock line speaks instead, and audio never waits on generation.
#NARRATION_ENABLED=true
# Defaults to INTENT_MODEL. Point this elsewhere only if you want a second
# model resident -- that is the one change here that costs VRAM.
#NARRATION_MODEL=
#NARRATION_TIMEOUT_SECS=1.2
#NARRATION_KEEP_ALIVE=5m

# The commons: a shared "_commons" folder inside AGENT_WORKSPACE_DIR where
# agents leave findings for each other and lessons for their own next run.
# Each dispatch carries a short briefing pointing at it. Borrowed notes are
# always labelled untrusted, because another agent wrote them.
#AGENT_COMMONS_ENABLED=true
#AGENT_COMMONS_FINDINGS=4
#AGENT_COMMONS_LESSONS=3
# Backends launched with tool approval disabled. Another agent's notes are
# never pasted into these ones' prompts -- nothing gates what they would act
# on. They are still told where the commons is and can read it themselves.
# Override only if you add a backend with the same kind of command line.
#AGENT_ELEVATED_BACKENDS_JSON={"openclaw":"","codex":"","claude-code":""}

# Agent-to-agent consulting: a running job may ask one other backend a single
# question and wait for the answer through the commons. Both sides are spoken
# aloud in their own voices. The limits are what keep a chain from becoming a
# loop -- depth 1 means a consulted agent cannot consult in turn.
#AGENT_CONSULT_ENABLED=true
#AGENT_CONSULT_MAX_DEPTH=1
#AGENT_CONSULT_BUDGET=2
#AGENT_CONSULT_TIMEOUT_SECS=120

# Remote agent backends. Run `python -m remote_agent_protocol.remote_host` on the
# other machine; its agents then appear here as "<host>:<agent>" (laptop:hermes).
# Both sides need the same token -- an agent runs real tools on the machine that
# offers it, so an unauthenticated host is not supported. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#AGENT_REMOTE_TOKEN=
#AGENT_REMOTE_HOSTS_JSON={"laptop":{"url":"http://192.168.1.50:8790"}}
#AGENT_REMOTE_HEARTBEAT_SECS=15
# Where remote_host listens when THIS machine serves its agents. Loopback until
# you deliberately expose it (start it with --host 0.0.0.0).
#AGENT_REMOTE_BIND_HOST=127.0.0.1
#AGENT_REMOTE_BIND_PORT=8790

# Agent safety, status, persistence, and timeouts.
#AGENT_CONFIRM_ENABLED=true
#AGENT_CONFIRM_LOOP_LIMIT=2
#AGENT_LLM_DELEGATE=true
# Maximum seconds with no agent output; progress resets this timer.
#AGENT_JOB_TIMEOUT_SECS=300
#AGENT_JOB_KILL_GRACE_SECS=3
#AGENT_PROGRESS_INTERVAL_SECS=30
#AGENT_VOICE_PROGRESS_MIN_SECS=20
#AGENT_VOICE_PROGRESS_INTERVAL_SECS=60
#AGENT_COMPLETION_GRACE_SECS=2
#AGENT_HISTORY_FILE=data/jess_agent_history.json

# Loopback-only lifecycle stream: ws://127.0.0.1:8765/events
#LIFECYCLE_WS_ENABLED=true
#LIFECYCLE_WS_PORT=8765
#LIFECYCLE_WS_QUEUE_SIZE=64
#AGENT_HISTORY_MAX=100
#AGENT_WORKSPACE_DIR=data/agent_workspace
#AGENT_HOST_REPO=

# Low-VRAM external voice mode. `scripts\start_voice.bat` forces brain mode,
# chooses dynamic loopback ports and a random bridge key, and starts all three
# processes. The fixed port/key values below apply to manual GUI/headless runs.
#RAP_MODE=full
#LLM_KEEP_ALIVE=5m
#INTENT_KEEP_ALIVE=5m
#S2S_BRIDGE_PORT=8788
#S2S_BRIDGE_API_KEY=local
#S2S_BRIDGE_MODEL=remote-agent-protocol
#S2S_BRIDGE_STREAMING=true
# Minimum active speech required to begin a new turn after the wake phrase;
# 384 ms accepts brief commands without lowering the VAD confidence threshold.
#S2S_VAD_MIN_SPEECH_MS=384
#S2S_VAD_MIN_SPEECH_CONTINUATION_MS=192
# End-of-turn patience, forwarded to the realtime frontend. Raise the first if
# it stops listening while you are still thinking; it is paid on every reply.
# The two reopen windows let a resumed sentence rejoin the turn it belongs to
# and cost nothing when you really had finished, so raise those first.
#S2S_VAD_MIN_SILENCE_MS=1200
#S2S_VAD_SPECULATIVE_REOPEN_MS=1000
#S2S_VAD_UNANSWERED_REOPEN_MS=4000
# Files polled by the RAP-aware realtime frontend.
#S2S_MIC_MUTE_FILE=data/s2s_mic_mute.json
#S2S_MIC_MUTE_STATUS_FILE=data/s2s_mic_mute_status.json
#S2S_MIC_MUTE_ACK_TIMEOUT=2.0
#S2S_VOICE_FILE=data/s2s_voice.txt
#S2S_VOICE_MODE_FILE=data/s2s_input_mode.json
#S2S_VOICE_MODE_STATUS_FILE=data/s2s_input_mode_status.json
#S2S_VOICE_MODE_ACK_TIMEOUT=8.0
#S2S_ANNOUNCE_FILE=data/s2s_announce.json
# Free Talk and Wake Word synchronize through the mode request/status files;
# Push To Talk is unavailable because the external client owns mic capture.
# The checkout is found beside this repo; set S2S_HOME only if it lives elsewhere.
#S2S_HOME=
#S2S_WS_PORT=8767
# Microphone and speakers the client opens, matched by name (a literal index
# pins one). Empty means the system default mic, and the frontend's own speakers.
#S2S_INPUT_DEVICE=
#S2S_OUTPUT_DEVICE=

# Semantic intent router. Explicit commands and keyword matches bypass it.
# See the "Model presets" block above for recommended INTENT_MODEL values;
# gemma-e4b-aggressive needs INTENT_TIMEOUT_SECS >= 3 for headroom under GPU
# contention with the voice model.
#INTENT_ROUTER_ENABLED=true
#INTENT_MODEL=llama3.2:1b
#INTENT_TIMEOUT_SECS=1.5

# Persisted GUI selection. Leave blank to always boot DEFAULT_PERSONA_NAME.
#APP_STATE_FILE=
