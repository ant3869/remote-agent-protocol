FROM python:3.12-slim AS python-contract
WORKDIR /workspace
RUN pip install --no-cache-dir pytest==9.0.3
COPY remote_agent_protocol/__init__.py remote_agent_protocol/conversation.py ./remote_agent_protocol/
COPY tests/test_conversation.py ./tests/
ENV PYTHONPATH=/workspace
CMD ["python", "-m", "pytest", "tests/test_conversation.py", "-q", "-k", "speaker_snapshot or stream_and_playback or jobs_keep or telemetry_does or consultation_groups"]

FROM node:22-bookworm-slim AS javascript
WORKDIR /workspace
COPY remote_agent_protocol/web_app/conversation.js ./remote_agent_protocol/web_app/
COPY tests/js/conversation.test.mjs ./tests/js/
CMD ["node", "--test", "tests/js/conversation.test.mjs"]
